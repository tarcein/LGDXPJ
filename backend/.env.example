# Copy this file to backend/.env. Keep the real key out of Git.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini

# Local developer preview only. Choose a private random token before enabling.
LGDX_DEV_MODE=0
LGDX_DEV_TOKEN=

# Require bearer sessions for all family data when moving beyond the local demo.
LGDX_REQUIRE_AUTH=0
LGDX_SEED_DEMO=0

# Future calendar OAuth applications (an API key alone cannot access a user's private calendar).
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
CALENDAR_REDIRECT_BASE=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
DATABASE_URL=

# Toss Payments. Payment-widget keys (gck/gsk) enable the inline one-month checkout.
# True automatic renewal requires an auto-billing contract and API individual integration keys.
# Only the public client key is returned to the signed-in family owner; the secret stays on the backend.
TOSS_BILLING_CLIENT_KEY=
TOSS_BILLING_SECRET_KEY=
TOSS_BILLING_AMOUNT=7900
# The backend checks due billing-key subscriptions every 5 minutes by default.
LGDX_BILLING_RENEWAL_WORKER=1
LGDX_BILLING_RENEWAL_INTERVAL_SECONDS=300
# Remind unanswered care requests after 15 minutes. Pro also records a device-alert
# outbox entry; it stays NOT_CONNECTED until real ThinQ credentials are added.
LGDX_ASSIGNMENT_REMINDER_WORKER=1
LGDX_ASSIGNMENT_REMINDER_INTERVAL_SECONDS=60

# Optional local media root. Default: backend/uploads/family_album/{family}/YYYY/MM/DD.
MEDIA_ROOT=

# Subsidy24 public-service benefits API key from data.go.kr / odcloud.
SUBSIDY24_SERVICE_KEY=

# Additional care/public-data APIs from data.go.kr.
# 아이돌봄 서비스 제공기관 현황
IDOL_CARE_INSTITUTION_SERVICE_KEY=
# 아이돌봄 가구소득 판정 기준
IDOL_CARE_HOUSEHOLD_INCOME_SERVICE_KEY=
# 아이돌봄 건강보험료 판정 기준
IDOL_CARE_HEALTH_INSURANCE_SERVICE_KEY=
# 전국어린이집표준데이터
CHILDCARE_CENTER_SERVICE_KEY=
