<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFF7F8">
    <TextView android:id="@+id/live_child" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#202124" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/live_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#C2185B" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/live_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#5F6368" android:textSize="12sp" />
</LinearLayout>
